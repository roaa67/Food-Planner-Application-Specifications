<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme based on Material Components as per course (p548-552)
    Using Theme.MaterialComponents.DayNight.NoActionBar
    Primary color: Green (Food themed)
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.FoodPlanner" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color (course p547 - colorPrimary) -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/dark_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="colorSecondaryVariant">@color/accent_orange</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/bg_main</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary_green</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <!-- Main app theme -->
    <style name="Theme.FoodPlanner" parent="Base.Theme.FoodPlanner" />

    <!-- Splash Screen theme - fullscreen, no status bar -->
    <style name="Theme.FoodPlanner.Splash" parent="Theme.FoodPlanner">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@color/bg_splash</item>
        <item name="android:navigationBarColor">@color/bg_splash</item>
    </style>

    <!-- MaterialCardView style (course p565-566) -->
    <style name="Widget.FoodPlanner.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="android:layout_margin">@dimen/spacing_sm</item>
    </style>

    <!-- Section Title style (reusable) -->
    <style name="TextAppearance.FoodPlanner.SectionTitle">
        <item name="android:textSize">@dimen/home_section_title_size</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif-medium</item>
    </style>

</resources>