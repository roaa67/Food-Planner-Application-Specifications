<?xml version="1.0" encoding="utf-8"?>
<!--
    My Planner Screen — Engineer 1 (Lead UI/UX)
    Matching design mockup media_1787127362856.png:
      - Top Bar: Back arrow + "My Planner" title
      - Week Navigation: < Aug 17 – Aug 23 > with interactive week date calculation
      - 7 Day rows (Mon–Sun)
      - Bottom Green Button: Add Meal
    Course ref: ConstraintLayout p217, RecyclerView p330, Material Components p548
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Top App Bar -->
    <RelativeLayout
        android:id="@+id/top_bar_planner"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Arrow (left) -->
        <ImageView
            android:id="@+id/btn_back_planner"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/cd_back_button"
            app:tint="@color/text_primary"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Title: My Planner (center) -->
        <TextView
            android:id="@+id/tv_planner_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_planner"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_centerInParent="true" />

    </RelativeLayout>

    <!-- Week Navigation Row: < Aug 17 – Aug 23 > -->
    <LinearLayout
        android:id="@+id/layout_week_nav"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/top_bar_planner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Previous week arrow (<) -->
        <ImageButton
            android:id="@+id/btn_prev_week"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/previous_week"
            app:tint="@color/text_primary" />

        <!-- Week range text -->
        <TextView
            android:id="@+id/tv_week_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            tools:text="Aug 17 – Aug 23" />

        <!-- Next week arrow (>) -->
        <ImageButton
            android:id="@+id/btn_next_week"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:rotation="180"
            android:contentDescription="@string/next_week"
            app:tint="@color/text_primary" />

    </LinearLayout>

    <!-- Days RecyclerView (Mon–Sun each row) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_planner_days"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_week_nav"
        app:layout_constraintBottom_toTopOf="@id/btn_add_meal_main"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="7"
        tools:listitem="@layout/item_planner_day" />

    <!-- Bottom Green Button: Add Meal -->
    <Button
        android:id="@+id/btn_add_meal_main"
        style="@style/Widget.FoodPlanner.PrimaryButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="@dimen/spacing_md"
        android:layout_marginBottom="16dp"
        android:text="@string/add_meal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
