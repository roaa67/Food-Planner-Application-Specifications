<?xml version="1.0" encoding="utf-8"?>
<!--
    Categories Screen — Engineer 1 (Lead UI/UX)
    2-column Grid of all categories with image + name + meal count
    Course ref: RecyclerView p330-335, ConstraintLayout p217-230
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Toolbar / Title -->
    <TextView
        android:id="@+id/tv_categories_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/categories"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Categories" />

    <!-- 2-column grid RecyclerView (course p335 - GridLayoutManager) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_categories_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/spacing_sm"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_categories_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="8"
        tools:listitem="@layout/item_category_grid" />

</androidx.constraintlayout.widget.ConstraintLayout>
