<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign Up Activity Layout
    Matches design mockup (media_1787050506269.png):
    - ConstraintLayout as root (Course p144-188)
    - Corner leaf decorations
    - Back button (Accessibility: touch target min 48dp, Course p192)
    - "Sign Up" title
    - Outlined TextInputLayouts with TextInputEditText (Course p555-556):
        1. Full Name
        2. Email
        3. Password
        4. Confirm Password
    - MaterialButton for Sign Up
    - Social sign up buttons (Google, Facebook, Apple)
    - "Already have an account? Login" link
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_splash"
    tools:context=".ui.auth.SignUpActivity">

    <!-- ══ Decorative Leaf (Top-Right) ══ -->
    <ImageView
        android:id="@+id/iv_leaf_top"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/leaf_decoration"
        android:rotation="90"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══ Decorative Leaf (Bottom-Right) ══ -->
    <ImageView
        android:id="@+id/iv_leaf_bottom"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:src="@drawable/leaf_decoration"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══ Back Button (Accessibility: min 48dp, Course p192) ══ -->
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="@dimen/touch_target_min"
        android:layout_height="@dimen/touch_target_min"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_md"
        android:src="@drawable/ic_back"
        android:padding="12dp"
        android:contentDescription="@string/cd_back_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scrollable container for all screen sizes -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_sm"
            android:paddingBottom="@dimen/spacing_lg"
            android:gravity="center_horizontal">

            <!-- ══ "Sign Up" Screen Title ══ -->
            <TextView
                android:id="@+id/tv_signup_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_up_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="@dimen/spacing_lg" />

            <!-- ══ Full Name TextInputLayout (Course p555-556) ══ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                style="@style/Widget.FoodPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/full_name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ══ Email TextInputLayout (Course p555-556) ══ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.FoodPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ══ Password TextInputLayout (Course p555-556) ══ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_password"
                style="@style/Widget.FoodPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/password_hint"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ══ Confirm Password TextInputLayout ══ -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_confirm_password"
                style="@style/Widget.FoodPlanner.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/confirm_password_hint"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirm_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_md" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ══ Sign Up MaterialButton (Course p554) ══ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_signup"
                style="@style/Widget.FoodPlanner.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/sign_up_button" />

            <!-- ══ "Or sign up with" ══ -->
            <TextView
                android:id="@+id/tv_or_signup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/or_sign_up_with"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm" />

            <!-- ══ Social Buttons Row (Google, Facebook, Apple) ══ -->
            <LinearLayout
                android:id="@+id/ll_social_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_md">

                <!-- Google Button (Accessibility: 48x48dp touch target, Course p192) -->
                <ImageButton
                    android:id="@+id/btn_google"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:src="@drawable/ic_google"
                    android:background="@drawable/bg_social_circle"
                    android:contentDescription="@string/sign_in_google"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:elevation="2dp" />

                <!-- Facebook Button -->
                <ImageButton
                    android:id="@+id/btn_facebook"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:src="@drawable/ic_facebook"
                    android:background="@drawable/bg_social_circle"
                    android:contentDescription="@string/sign_in_facebook"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:elevation="2dp" />

                <!-- Apple Button -->
                <ImageButton
                    android:id="@+id/btn_apple"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:src="@drawable/ic_apple"
                    android:background="@drawable/bg_social_circle"
                    android:contentDescription="@string/sign_in_apple"
                    android:elevation="2dp" />

            </LinearLayout>

            <!-- ══ "Already have an account? Login" ══ -->
            <LinearLayout
                android:id="@+id/ll_login_link"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/already_have_account"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tv_go_to_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_button"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_sm"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
