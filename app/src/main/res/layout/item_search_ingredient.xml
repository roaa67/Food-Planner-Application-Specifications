<?xml version="1.0" encoding="utf-8"?>
<!--
    Popular Ingredient chip item — Engineer 1
    Circular image + ingredient name below
    Course ref: ImageView p175, RecyclerView items p332
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="@dimen/spacing_xs"
    android:layout_marginEnd="@dimen/spacing_sm">

    <!-- Circular ingredient image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_ingredient"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/cd_meal_image"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        tools:src="@drawable/ic_chef_logo"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- Ingredient Name -->
    <TextView
        android:id="@+id/tv_ingredient_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="@dimen/text_xs"
        android:textColor="@color/text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp"
        tools:text="Chicken" />

</LinearLayout>
