<?xml version="1.0" encoding="utf-8"?>
<!--
    Recommendation / For You Fragment Layout — Engineer 1 (Lead UI/UX)
    Matching user mockup media_1787101644465.png:
      - Top Bar: Drawer icon, "Daily Recommendation" title, Bell icon
      - Recommendation Card:
          * 🌿 Today's Recommendation 🌿
          * Meal Name (e.g. Spicy Lemon Chicken)
          * Flag & Country (e.g. 🇹🇭 Thailand)
          * Large rounded meal image
          * Pagination dots indicator
          * Navigation arrows: ← Swipe to discover more →
    Course ref: ConstraintLayout p217-230, MaterialCardView p565-566
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recommendation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Top App Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Drawer menu icon (left) -->
        <ImageButton
            android:id="@+id/btn_menu_drawer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="@string/app_name"
            app:tint="@color/dark_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Title: Daily Recommendation -->
        <TextView
            android:id="@+id/tv_top_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/daily_recommendation"
            android:textColor="@color/dark_green"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Bell icon (right) -->
        <ImageButton
            android:id="@+id/btn_notification"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_reminder"
            android:contentDescription="@string/daily_recommendation"
            app:tint="@color/dark_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Center Card View (Today's Recommendation) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_recommendation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- Subtitle Header: 🌿 Today's Recommendation 🌿 -->
            <TextView
                android:id="@+id/tv_card_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌿   Today's Recommendation   🌿"
                android:textColor="@color/dark_green"
                android:textSize="13sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Meal Name (e.g. Spicy Lemon Chicken) -->
            <TextView
                android:id="@+id/tv_rec_meal_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/dark_green"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tv_card_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Spicy Lemon Chicken" />

            <!-- Flag + Country (e.g. 🇹🇭 Thailand) -->
            <LinearLayout
                android:id="@+id/layout_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tv_rec_meal_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tv_rec_flag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:layout_marginEnd="6dp"
                    tools:text="🇹🇭" />

                <TextView
                    android:id="@+id/tv_rec_country"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Thailand" />

            </LinearLayout>

            <!-- Large Rounded Meal Image -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_rec_meal_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_meal_image"
                app:shapeAppearanceOverlay="@style/RoundedImageView24"
                app:layout_constraintTop_toBottomOf="@id/layout_country"
                app:layout_constraintBottom_toTopOf="@id/layout_dots"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:src="@drawable/ic_chef_logo" />

            <!-- Dots Indicator (● ○ ○ ○) -->
            <LinearLayout
                android:id="@+id/layout_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toTopOf="@id/layout_swipe_navigation"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/dot_0"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_dot_active" />

                <View
                    android:id="@+id/dot_1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_dot_inactive" />

                <View
                    android:id="@+id/dot_2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_dot_inactive" />

                <View
                    android:id="@+id/dot_3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_dot_inactive" />

            </LinearLayout>

            <!-- Bottom Swipe Navigation Row: ← Swipe to discover more → -->
            <LinearLayout
                android:id="@+id/layout_swipe_navigation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Left Arrow Button (Previous Card / Swap Left) -->
                <ImageButton
                    android:id="@+id/btn_swipe_left"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/previous_week"
                    app:tint="@color/text_secondary" />

                <!-- Swipe instruction text -->
                <TextView
                    android:id="@+id/tv_swipe_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/swipe_discover_more"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Right Arrow Button (View Recipe / Swap Right) -->
                <ImageButton
                    android:id="@+id/btn_swipe_right"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    android:rotation="180"
                    android:contentDescription="@string/view_recipe"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
