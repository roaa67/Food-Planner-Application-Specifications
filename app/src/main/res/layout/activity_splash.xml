<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash Screen - matches the uploaded design reference:
    - Warm cream/off-white background (#FAF9F4)
    - Food images decoratively placed at corners (replace with real images)
    - Green chef logo icon centered
    - "Food Planner" bold title
    - Tagline subtitle
    - Pagination dots at bottom
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_splash"
    tools:context=".ui.splash.SplashActivity">

    <!-- ══════════════════════════════════════
         TOP CORNER FOOD IMAGES (decorative)
         Replace src with real food photos
    ══════════════════════════════════════ -->

    <!-- Top-Left: Herbs / Leaves (green herbs) -->
    <ImageView
        android:id="@+id/img_top_left"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/food_top_left"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Top-Right: Pasta bowl / food bowl -->
    <ImageView
        android:id="@+id/img_top_right"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/food_top_right"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom-Left: White sauce / cream bowl -->
    <ImageView
        android:id="@+id/img_bottom_left"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/food_bottom_left"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom-Right: Tomatoes + green bowl -->
    <ImageView
        android:id="@+id/img_bottom_right"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/food_bottom_right"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════
         CENTER CONTENT GROUP
    ══════════════════════════════════════ -->

    <!-- Chef Logo Icon (matches uploaded design) -->
    <ImageView
        android:id="@+id/iv_chef_logo"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_chef_logo"
        android:contentDescription="@string/app_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.45" />

    <!-- "Food Planner" Title -->
    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/dark_green"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.01"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/iv_chef_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_tagline" />

    <!-- Tagline: "Plan your meals.\nEnjoy healthy life!" -->
    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan your meals.\nEnjoy healthy life!"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ll_dots" />

    <!-- ══════════════════════════════════════
         PAGINATION DOTS at bottom
         (matches design: 1 green active + 2 inactive)
    ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/ll_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Active dot (wide green pill) -->
        <View
            android:layout_width="20dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_active"
            android:layout_marginEnd="6dp" />

        <!-- Inactive dot 1 -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_inactive"
            android:layout_marginEnd="6dp" />

        <!-- Inactive dot 2 -->
        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_inactive" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
