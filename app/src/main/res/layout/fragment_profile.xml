<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    tools:context=".ui.profile.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Profile Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="@color/dark_green"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="104dp"
                android:layout_height="104dp"
                app:cardBackgroundColor="@color/light_green"
                app:cardCornerRadius="52dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_profile_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_profile_image"
                    android:padding="16dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_profile"
                    app:shapeAppearanceOverlay="@style/CircleImageView" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Mohamed" />

            <TextView
                android:id="@+id/tv_profile_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                tools:text="mohamed@example.com" />

        </LinearLayout>

        <!-- Account Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:text="Your account"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <include
                android:id="@+id/menu_my_planner"
                layout="@layout/item_profile_menu" />

            <include
                android:id="@+id/menu_favorites"
                layout="@layout/item_profile_menu" />

            <include
                android:id="@+id/menu_my_recipes"
                layout="@layout/item_profile_menu" />

        </LinearLayout>

        <!-- App Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:text="App"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical">

            <include
                android:id="@+id/menu_settings"
                layout="@layout/item_profile_menu" />

            <include
                android:id="@+id/menu_help"
                layout="@layout/item_profile_menu" />

            <include
                android:id="@+id/menu_about"
                layout="@layout/item_profile_menu" />

            <include
                android:id="@+id/menu_logout"
                layout="@layout/item_profile_menu" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>