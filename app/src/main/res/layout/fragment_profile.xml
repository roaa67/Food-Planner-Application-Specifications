<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile Screen — Engineer 1 (Lead UI/UX)
    Dark green header + profile photo + name/email + white menu list
    Course ref: ConstraintLayout p217, ScrollView p210, LinearLayout p202
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Dark Green Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/dark_green"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Circular Profile Photo -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_profile_photo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/cd_profile_image"
                app:shapeAppearanceOverlay="@style/CircleImageView"
                app:strokeColor="@color/white"
                app:strokeWidth="3dp"
                android:src="@drawable/ic_profile"
                android:background="@color/light_green" />

            <!-- User Name -->
            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg"
                android:textStyle="bold"
                tools:text="Heba Mohamed" />

            <!-- User Email -->
            <TextView
                android:id="@+id/tv_profile_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B2FFFFFF"
                android:textSize="@dimen/text_sm"
                tools:text="heba@example.com" />

        </LinearLayout>

        <!-- White menu card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_md"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/spacing_sm"
                android:paddingBottom="@dimen/spacing_sm">

                <!-- My Planner -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_my_planner" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" />

                <!-- Favorites -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_favorites" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" />

                <!-- My Recipes -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_my_recipes" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" />

                <!-- Settings -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_settings" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" />

                <!-- Help & Support -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_help" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" />

                <!-- About Us -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_about" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginStart="@dimen/spacing_md" android:layout_marginEnd="@dimen/spacing_md" />

                <!-- Logout -->
                <include layout="@layout/item_profile_menu"
                    android:id="@+id/menu_logout" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
