<?xml version="1.0" encoding="utf-8"?>
<!--
    Favorites Screen — Engineer 1 (Lead UI/UX)
    Scrollable list of saved meals with image/name/time/heart
    Course ref: RecyclerView p330-335, ConstraintLayout p217
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Screen Title -->
    <TextView
        android:id="@+id/tv_favorites_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/favorites"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_sm"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Favorites RecyclerView (course p330 - LinearLayoutManager) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorites"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/spacing_sm"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:itemCount="4"
        tools:listitem="@layout/item_favorite" />

    <!-- Empty state (shown when no favorites, using Group visibility toggle course p232) -->
    <LinearLayout
        android:id="@+id/layout_empty_favorites"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_xl"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_favorites_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_favorites"
            android:contentDescription="@null"
            android:alpha="0.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_favorites"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_md"
            android:layout_marginTop="@dimen/spacing_sm" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
