<?xml version="1.0" encoding="utf-8"?>
<!--
    Category Item Layout (course p334 - "Create a list item (custom row) layout")
    MaterialCardView containing image + name
    Touch target: minimum 48dp x 48dp (course p192)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/category_item_size"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/spacing_sm">

        <!-- Category Image - with contentDescription for accessibility (course p197) -->
        <ImageView
            android:id="@+id/iv_category"
            android:layout_width="@dimen/category_image_size"
            android:layout_height="@dimen/category_image_size"
            android:contentDescription="@string/cd_category_image"
            android:scaleType="centerCrop" />

        <!-- Category Name -->
        <TextView
            android:id="@+id/tv_category_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
