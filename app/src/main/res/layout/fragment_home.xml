<?xml version="1.0" encoding="utf-8"?>
<!--
    Home Fragment Layout
    - NestedScrollView as root (allows scrolling content)
    - LinearLayout inside with vertical orientation (course p139)
    - Header section with greeting
    - Meal of Day MaterialCardView (course p565-566)
    - Categories RecyclerView horizontal (course p329-336)
    - Countries RecyclerView horizontal
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/spacing_lg">

        <!-- ===== HEADER SECTION ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_md">

            <!-- Greeting Text "Good morning, Heba 🌟" -->
            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/good_morning"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_md"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/iv_profile"
                tools:text="Good morning," />

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/home_greeting_size"
                android:textStyle="bold"
                android:layout_marginTop="@dimen/spacing_xs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_greeting"
                app:layout_constraintEnd_toStartOf="@id/iv_profile"
                tools:text="Heba 🌟" />

            <!--
                Profile Image
                Accessibility: contentDescription set (course p197)
                Touch target: 48dp x 48dp minimum (course p192)
            -->
            <ImageView
                android:id="@+id/iv_profile"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:contentDescription="@string/cd_profile_image"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                android:background="@drawable/circle_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== MEAL OF THE DAY CARD ===== -->
        <!--
            MaterialCardView (course p565-566)
            "A card holds content and actions for a single item"
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_meal_of_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_md"
            app:cardCornerRadius="@dimen/card_radius_lg"
            app:cardElevation="@dimen/card_elevation">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Meal Image -->
                <ImageView
                    android:id="@+id/iv_meal_of_day"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/meal_of_day_height"
                    android:contentDescription="@string/cd_meal_image"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:src="@drawable/ic_home" />

                <!-- "Meal of the Day" Label -->
                <TextView
                    android:id="@+id/tv_meal_of_day_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/meal_of_the_day"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold"
                    android:background="@color/primary_green"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_sm"
                    android:paddingTop="@dimen/spacing_xs"
                    android:paddingBottom="@dimen/spacing_xs"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_margin="@dimen/spacing_sm" />

                <!-- Meal Name -->
                <TextView
                    android:id="@+id/tv_meal_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/iv_meal_of_day"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_add_favorite"
                    tools:text="Chicken Alfredo Pasta" />

                <!-- Favorite Button (heart icon) - touch target 48dp (course p192) -->
                <ImageView
                    android:id="@+id/btn_add_favorite"
                    android:layout_width="@dimen/touch_target_min"
                    android:layout_height="@dimen/touch_target_min"
                    android:contentDescription="@string/cd_favorite_button"
                    android:src="@drawable/ic_favorites"
                    android:padding="@dimen/spacing_sm"
                    android:tint="@color/heart_red"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@id/iv_meal_of_day"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="@dimen/spacing_sm" />

                <!-- View Recipe Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_recipe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/view_recipe"
                    android:textColor="@color/white"
                    android:layout_marginStart="@dimen/spacing_md"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:layout_marginBottom="@dimen/spacing_md"
                    app:backgroundTint="@color/primary_green"
                    app:cornerRadius="@dimen/spacing_xl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_meal_name"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== CATEGORIES SECTION ===== -->
        <!-- Section Header: Title + "See all" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg">

            <TextView
                android:id="@+id/tv_categories_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/categories"
                style="@style/TextAppearance.FoodPlanner.SectionTitle" />

            <!-- "See All" link - touch target min 48dp (course p192) -->
            <TextView
                android:id="@+id/tv_see_all_categories"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/see_all"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_md"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm" />
        </LinearLayout>

        <!--
            Categories RecyclerView (course p329-336)
            Horizontal LinearLayoutManager - grid of categories
            "RecyclerView: Widget for displaying lists of data"
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_category" />

        <!-- ===== POPULAR COUNTRIES SECTION ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_marginEnd="@dimen/spacing_md"
            android:layout_marginTop="@dimen/spacing_lg">

            <TextView
                android:id="@+id/tv_countries_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/popular_countries"
                style="@style/TextAppearance.FoodPlanner.SectionTitle" />

            <TextView
                android:id="@+id/tv_see_all_countries"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_min"
                android:text="@string/see_all"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_md"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm" />
        </LinearLayout>

        <!--
            Countries RecyclerView (course p329-336) - horizontal
        -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_countries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_country" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
