<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml
    Course reference (p44-45): "Where the application components must be declared"
    - <activity> elements for each activity (course p44)
    - intent-filter for launcher activity (course p57)
    - INTERNET permission for API calls (course p608)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet permission for TheMealDB API (course p608) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodPlanner">

        <!--
            SplashActivity – LAUNCHER (entry point)
            Course ref (p57): "MainActivity needs to include an intent filter to start from the launcher"
            Uses Splash theme (fullscreen)
        -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FoodPlanner.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MainActivity – Hosts all fragments via BottomNavigationView
            Not the launcher – reached after Splash / Auth
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            LoginActivity – Email/Password, Social Auth, and Guest Mode
            Course ref (p44): declare Activity component in manifest
        -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            SignUpActivity – User registration
        -->
        <activity
            android:name=".ui.auth.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            MealDetailsActivity – Shows full meal info, ingredients, steps, and video
            Engineer 1: TabLayout + ViewPager2, embedded WebView video player (course p498-505)
        -->
        <activity
            android:name=".ui.mealdetails.MealDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

    </application>

</manifest>